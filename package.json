{
    "name": "coagro-studio",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "tsx server.ts",
        "start": "node server.js",
        "build": "vite build && npm run build:server && node scripts/version-sw.mjs",
        "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js --log-level=warning",
        "build:electron": "vite build && electron-builder",
        "preview": "vite preview",
        "clean": "rm -rf dist server.js",
        "lint": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.server.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "fix:encoding": "node scripts/fix-encoding.mjs"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@imgly/background-removal": "^1.7.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "express-rate-limit": "^8.7.1",
        "firebase": "^12.19.0",
        "html-to-image": "^1.11.13",
        "jspdf": "^4.2.1",
        "lucide-react": "^0.546.0",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "vite": "^8.3.0",
        "xlsx": "^0.18.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "electron": "^28.3.3",
        "electron-builder": "^24.13.3",
        "esbuild": "^0.28.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.21.0",
        "typescript": "5.9.3",
        "vitest": "^5.0.3"
    },
    "build": {
        "appId": "com.coagro.studio",
        "productName": "Coagro Studio",
        "directories": {
            "output": "dist_electron"
        },
        "win": {
            "target": "nsis",
            "icon": "public/icon.jpg"
        },
        "files": [
            "dist/**/*",
            "electron/main.js"
        ]
    },
    "description": "Ferramenta interna de criação e governança visual de cartazes e peças digitais do Grupo Coagro.",
    "author": "Departamento de Marketing — Grupo Coagro"
}
